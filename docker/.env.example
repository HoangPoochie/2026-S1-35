# This is the file docker compose actually reads (it's run from inside this
# folder: `cd docker && docker compose up`). Copy this to `.env` in this same
# folder, or just run the setup script from the project root, which does it
# for you and fills in secure random secrets automatically.

# MySQL Database
DB_NAME=bvom
DB_USER=bvom_user
DB_PASSWORD=__RANDOM_DB_PASSWORD__
DB_ROOT_PASSWORD=__RANDOM_DB_ROOT_PASSWORD__

# Admin login (used to sign in at /admin)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=__RANDOM_ADMIN_PASSWORD__

# Used to reset the admin password if it's ever lost - keep this safe.
ADMIN_RECOVERY_KEY=__RANDOM_RECOVERY_KEY__

# Signs admin session cookies. Never leave this as a placeholder - a known
# value lets anyone forge an admin login.
SESSION_SECRET=__RANDOM_SESSION_SECRET__

# Cloudflare Tunnel (optional) - only needed if exposing the app to the
# public internet via the commented-out `cloudflared` service below. Leave
# blank if you're only running this locally.
CLOUDFLARE_TUNNEL_TOKEN=
TUNNEL_URL=
